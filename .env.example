# Copy to .env.local and fill in from the Firebase console:
#   Project settings -> General -> Your apps -> Web app -> SDK setup and configuration
#
# These are not secrets. Firebase web config is public by design and is visible
# in the shipped bundle; firestore.rules is what actually protects your data.
#
# Vite only exposes variables prefixed with VITE_. Restart the dev server after
# editing this file.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Only needed if you deploy to a GitHub Pages project site and want absolute
# asset URLs instead of the relative default. Example: /kanji-app/
# VITE_BASE_PATH=
