node_modules/
dist/
dist-ssr/

# Generated from src/firebaseConfig.example.ts on first `npm run dev`/`build`.
# Kept out of git so each clone points at its own Firebase project.
src/firebaseConfig.ts

.env
.env.local
.env.*.local

# Raw Tatoeba export, downloaded on demand by scripts/build-sentences.mjs.
# ~200 MB; the built sentence packs in public/sentences/ are what ships.
data/tatoeba/

# KanjiVG's full stroke dump, downloaded on demand by scripts/build-strokes.mjs.
# Only the 205 characters Kanji Canvas lacks are taken from it, and the result
# is committed in public/strokes/.
data/kanjivg.xml.gz

*.log
npm-debug.log*
.DS_Store
.vscode/*
!.vscode/extensions.json
.idea/

# Compiled from data/*.csv by `npm run decks`, which prebuild runs. Generated
# rather than committed because the CSVs they come from are right there.
#
# public/sentences/ is deliberately NOT ignored, and the reason is not size --
# the Tatoeba export is 3.4 MB and builds in under two seconds. It is
# reproducibility: Tatoeba updates weekly, so building the packs in CI would
# silently change which sentences the quizzes ask, build to build. Committing
# them pins the questions. Re-run `npm run sentences` to take an update
# deliberately.
public/decks/

# Cloned by `npm run strokes`. The built patterns in public/strokes/ are what
# ships; this is the 7 MB source they come from.
data/kanjicanvas/

# The CLI's exported scores are personal study data and public/ is the web root
# -- anything in it is served. They live in data/, which is not.
public/scores*.txt
public/*.txt

# Screenshots from `npm run ui`.
.ui/
